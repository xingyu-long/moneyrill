# Separate from .env (Sandbox). Never place Production keys in staging.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
APP_ENV=production
# Generate once; preserve when reusing the production database volume.
POSTGRES_PASSWORD=
# Optional HTTPS callback registered in the Plaid Dashboard; leave empty for popup flows.
PLAID_REDIRECT_URI=
# Optional: reach the app from other devices on your Wi-Fi (no sign-in yet; see docs/development/OPERATIONS.md and TODO.md).
# BIND_ADDRESS=<this computer's Wi-Fi address, e.g. 192.168.1.20; never 0.0.0.0>
# ALLOW_LAN=true
# Optional: reach it from your own devices over HTTPS with `tailscale serve` (see docs/development/OPERATIONS.md).
# TAILSCALE_HOST=<this computer's MagicDNS name, e.g. my-mac.tail1234.ts.net>
# TRUST_PROXY=true
# Optional: the name of this installation (Docker projects, database volume and user). Choose it once; see
# docs/development/OPERATIONS.md. Default: moneyrill
# INSTANCE_NAME=moneyrill
# Optional: the port published on this computer (http://localhost:<port>). Default: 3003
# PRODUCTION_PORT=3003
