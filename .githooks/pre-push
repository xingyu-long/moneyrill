#!/bin/sh
# Refuses direct pushes to main. Open a pull request instead: ./scripts/pr.sh "Title"
# Emergency only: ALLOW_MAIN_PUSH=1 git push
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
    echo "Direct pushes to main are blocked. Push a branch and open a pull request:" >&2
    echo "  ./scripts/branch.sh name   (if you have not yet)   then   ./scripts/pr.sh \"Title\"" >&2
    exit 1
  fi
done
exit 0
